.03586,0,0,0.03586,0.10564,0,0.07172,0,0.03586,0,0.03586,0.03586,0.06071,0.03586,0.03586,0.03586,0.03586,0.03586,0,0.11111,0,0.07172,0.07172,0,0.03586,0,0.03586,0.11111,0.03586,0.03586,0.09657,0.03586,0.10758,0,0.10758,0.03586,0.03586,0.03586,0.07172,0.10758,0.13243,0,0.03586,0.06071,0.07172,0,0,0.07172]},{"id":"moe-shared::moe-9b2f4206ee9bebc5::36","bookId":"moe-9b2f4206ee9bebc5","title":"كتاب تقنية المعلومات للصف الحادي عشر الفصل الأول","subjectId":"general","pageStart":98,"pageEnd":100,"chunkIndex":36,"text":"وﺗﻬﺪف إىل ﺗﻘﻴﻴـﻢ اﻷداء املﺎيل وﻣـﺪى ﻛﻔﺎءة املﺆﺳﺴـﺔ يف إدارة ﻣﻮاردﻫـﺎ املﺎﻟﻴﺔ، وﺗﻘﻴﻴﻢ املﺨﺎﻃﺮ اﻟﺘﻲ ﻗﺪ ﺗﻮاﺟﻬﻬﺎ املﺆﺳﺴـﺔ، ﺑﺎﻹﺿﺎﻓﺔ إىل اﻟﻘﻮاﻧ\u001e واﻟﻠﻮاﺋﺢ املﺴـﺘﺨﺪﻣﺔ يف ﻣﺘﻄﻠﺒﺎت اﻟﺘﺴـﺠﻴﻞ. وﻳﺘﻢ إﻋﺪاد اﻟﺘﻘﺎرﻳﺮ املﺎﻟﻴﺔ ﻣﻦ ﻗﺒﻞ إدارة املﺆﺳﺴﺔ أو ﻗﺴﻢ املﺤﺎﺳﺒﺔ. ˾˺ ɐҟԊӴӂҽӮʩɐҽԋӞɐӥҒҕҩԀӮʩˑɐҟԊӴӂҽӮʩɐӥҒҕҩԀӮʩ ɐ ( dǾȰǧĵǘɐ6ǾŠɫǧŽǭɕȹɐĵǭŰɐvǭƘǾȰǧĵǘɐ6ǾŠɫǧŽǭɕȹȚ ﻳﺨﺘﻠـﻒ أﺳـﻠﻮب ﻛﺘﺎﺑـﺔ اﻟﻮﺛﺎﺋـﻖ اﻟﺨﺎﺻـﺔ ﺑـﺎﻷﻋ\u0006ل، ﻓﻘـﺪ ﺗﻜﺘﺐ ﺑﺼﻴﻐـﺔ رﺳـﻤﻴﺔ أو ﺑﺼﻴﻐﺔ ﻏ\u0013 رﺳـﻤﻴﺔ وﻓﻘًﺎ ﻟﻠﻔﺌﺔ املﺴﺘﻬﺪﻓﺔ واﻟﻬﺪف ﻣﻨﻬﺎ. ( dǾȰǧĵǘɐ6ǾŠɫǧŽǭɕȹȚɐҟԊӴӂҽӮʩɐӥҒҕҩԀӮʩ ﺗُﺴـﺘﺨﺪم اﻟﻮﺛﺎﺋـﻖ اﻟﺮﺳـﻤﻴﺔ ﻟﺘﻘﺪﻳـﻢ ﻣﻌﻠﻮﻣـﺎت دﻗﻴﻘﺔ وﻣﻮﺛﻮﻗﺔ ﻋـﻦ ﻣﻮﺿﻮع ﻣﻌ، وﺗُﻜﺘﺐ ﺑﺼﻴﺎﻏﺔ رﺳـﻤﻴﺔ ﺗﻜـﻮن ﻓﻴﻬـﺎ اﻟﻠﻐـﺔ واﺿﺤﺔ وﻣﺒـﺎرشة وﻣﻔﻬﻮﻣـﺔ ﻟﻠﻤﺘﻠﻘﻲ، ﻣـﻊ اﻟﺘﺄﻛﻴـﺪ ﻋىل اﻷدوار واﻟربوﺗﻮﻛـﻮﻻت اﻟﻮﻇﻴﻔﻴﺔ. ﺗﺼـﺪر اﻟﻮﺛﺎﺋـﻖ اﻟﺮﺳـﻤﻴﺔ ﻣـﻦ ﺟﻬـﺔ رﺳـﻤﻴﺔ ﻣ\u0006 ¯ﻨﺤﻬـﺎ اﻟﺼﻼﺣﻴـﺔ اﻟﻘﺎﻧﻮﻧﻴـﺔ. وﻣـﻦ اﻷﻣﺜﻠـﺔ ﻋﻠﻴﻬـﺎ: اﻟﻌﻘـﻮد واﻟﺸﻬﺎدات، واﻟﺘﻘﺎرﻳﺮ اﻟﺴﻨﻮﻳﺔ ﻟﻠﻤﺆﺳﺴﺎت وﻏ\u0013ﻫﺎ. ( dǾȰǧĵǘɐ>ǧĵǇǘȚɐԄӵӂҽӮʩɐԄӸˑҽҤӫӮԓʩɐҹԅҽқӮʩ ﻳﻌـﺪ اﻟربﻳـﺪ اﻹﻟـﻜرتو¹ أﺷـﻬﺮ اﻷدوات اﺳـﺘﺨﺪاﻣًﺎ يف إرﺳـﺎل وﺛﺎﺋـﻖ اﻷﻋ\u0006ل يف وﻗﺘﻨـﺎ اﻟﺤـﺎيل. ﻓﻤﻨـﺬ ﻇﻬـﻮر اﻹﻧرتﻧـﺖ، ﺑـﺮز اﻟربﻳـﺪ اﻹﻟـﻜرتو¹ ﻛﻌﻨرص ﺣﻴـﻮي يف اﺗﺼﺎﻻت اﻷﻋ\u0006ل. وﻋىل ﻣﺮ اﻟﺴـﻨ، ﻃﻮرت رﺳـﺎﺋﻞ اﻟربﻳﺪ اﻹﻟـﻜرتو¹ اﻟﺮﺳـﻤﻴﺔ أﺳـﻠﻮﺑًﺎ وﻫﻴـﻜﻼ ً ﻣﻤﻴﺰﻳـﻦ ﻳُﺴـﺘﺨﺪﻣﺎن ﻋىل ﻧﻄـﺎق واﺳـﻊ ﻹﻧﺸـﺎء رﺳـﺎﺋﻞ ﻣﺆﺛـﺮة ﺑﺸـﻜﻞ اﺳﺘﺜﻨﺎÆ. ﺣﻴـﺚ ﻳﺨﺘﻠـﻒ أﺳـﻠﻮب ﻛﺘﺎﺑـﺔ اﻟربﻳـﺪ اﻹﻟﻜرتو¹ اﻟﺮﺳـﻤﻲ ﻣﻦ اﻟربﻳﺪ ﻏ\u0013 اﻟﺮﺳـﻤﻲ. و¯ﻜﻦ أن ﻳﻌﺘﻤﺪ ﻣﺴـﺘﻮى اﻹﺟﺮاءات ﻋىل اﻟرشﻛﺔ أو اﻟﺠﻤﻬﻮر املﺴﺘﻬﺪف أو املﻮﺿﻮع أو ﻋﺪة ﻋﻮاﻣﻞ أﺧﺮى. ﺗﺘﻀﻤـﻦ رﺳـﺎﻟﺔ اﻟربﻳـﺪ اﻹﻟـﻜرتو¹ اﻟﺮﺳـﻤﻴﺔ ﺳـﻄﺮ ﻋﻨﻮان ﻣﺨـﺘرص، وﻟﻜﻨﻪ وﺻﻔـﻲ وﻣﺮﻓﻖ إذا ﻟـﺰم اﻷﻣﺮ، و¯ﻜﻦ إرﺳﺎل اﻟﺮﺳﺎﻟﺔ إىل ﻋﺪة ﻣﺴﺘﻠﻤ ﺑﺎﺳﺘﺨﺪام اﻟﺤﻘﻞ Cc )ﻧﺴﺨﺔ(. ( vǭƘǾȰǧĵǘɐ6ǾŠɫǧŽǭɕȹȚɐҟԊӴӂҽӮʩɐҽԋӞɐӥҒҕҩԀӮʩ ﺗُﺴـﺘﺨﺪم اﻟﻮﺛﺎﺋـﻖ ﻏ\u0013 اﻟﺮﺳـﻤﻴﺔ ﻟﻠﺘﻌـﺒ\u0013 ﻋـﻦ اﻷﻓـﻜﺎر واﻵراء ﺑﺄﺳـﻠﻮب ﺣـﺮ وﻋﻔﻮي ﻋىل املﺴـﺘﻮى اﻟﺸـﺨيص، وﺗُﻜﺘـﺐ ﺑﺼﻴﺎﻏـﺔ ﻏ\u0013 رﺳـﻤﻴﺔ ﺗﻜـﻮن ﻓﻴﻬﺎ اﻟﻠﻐﺔ ﺳـﻬﻠﺔ وودﻳﺔ؛ ﺑﻬـﺪف اﻟﺘﻮاﺻﻞ ﻣﻊ اﻵﺧﺮﻳﻦ، وﺑﻨـﺎء اﻟﻌﻼﻗﺎت، وﻣﺸـﺎرﻛﺔ اﻷﻓـﻜﺎر ﺑـﺪﻻ ً ﻣﻦ اﻟرتﻛﻴـﺰ ﻋىل اﻟﺘﺴﻠﺴـﻞ اﻟﻬﺮﻣﻲ أو املﺮﻛـﺰ اﻻﺟﺘ\u0006ﻋﻲ ﻟﻸﻓﺮاد. ﻗـﺪ ﺗﺘﻀﻤﻦ اﻟﻮﺛﺎﺋﻖ ﻏ\u0013 اﻟﺮﺳـﻤﻴﺔ ﺣـﻮارات وأﻣﺜﻠـﺔ ﻟﺘﻮﺿﻴﺢ اﻷﻓـﻜﺎر املﻌﻘﺪة. وﻣﻦ اﻷﻣﺜﻠـﺔ ﻋﻠﻴﻬﺎ: املﺤﺎدﺛﺎت اﻟﻴﻮﻣﻴﺔ املﺴـﺘﺨﺪﻣﺔ ﻟﻠﺘﻮاﺻﻞ ﻣﻊ اﻵﺧﺮﻳﻦ، واملﺪوﻧﺎت اﻟﺸﺨﺼﻴﺔ، واﻟربﻳﺪ اﻹﻟﻜرتو¹ اﻟﺸﺨيص. ˾˼ ﻋىل اﻟﺮﻏـﻢ ﻣـﻦ أن رﺳـﺎﺋﻞ اﻟربﻳـﺪ اﻹﻟﻜرتو ﻣـﻦ املﻔرتض أن ﺗﻜﻮن رسﻳﻌـﺔ، ﻓﺈﻧﻪ ﻳﺘﻌ\u000e ﻋﻠﻴـﻚ دا\u0016ًﺎ أن ﺗﺄﺧﺬ ﺑﻌـﺾ اﻟﻮﻗـﺖ ﻣـﻦ أﺟﻞ ﺗﺪﻗﻴـﻖ ﻛﺘﺎﺑﺎﺗﻚ ﻗﺒﻞ إرﺳـﺎﻟﻬﺎ، ﺣﻴﺚ ﻳﺠـﺐ إﺟـﺮاء اﻟﺘﺼﺤﻴﺤﺎت اﻹﻣﻼﺋﻴـﺔ واﻟﻨﺤﻮﻳﺔ، واﻟﺘﺄﻛـﺪ ﻣـﻦ دﻗـﺔ أي ﺣﻘﺎﺋـﻖ ﺗﻘﺪﻣﻬـﺎ وإرﻓـﺎق ﺟﻤﻴـﻊ املﺮﻓﻘـﺎت املﺬﻛـﻮرة يف ﻣﺤﺘـﻮى اﻟربﻳـﺪ، وأن اﻟﺮواﺑـﻂ املﻀﻤﻨـﺔ ﺗﻌﻤـﻞ ﺑﺸـﻜﻞ ﺻﺤﻴـﺢ. ﻛ¯ أن إﻋـﺎدة ﻗـﺮاءة اﻟربﻳﺪ اﻹﻟﻜرتو ﺗﺴـﺎﻋﺪك يف اﻟﻌﺜـﻮر ﻋىل اﻟﻜﻠ¯ت أو اﻟﻌﺒﺎرات اﻟﺘﻲ ﺗﺤﺘﺎج إىل ﺗﺼﺤﻴﺢ أو إﻋﺎدة ﺻﻴﺎﻏﺔ. ( áɕȰɫŠɕɫȰŽɐǾƘɐdǾȰǧĵǘɐ>ǧĵǇǘȚɐԄӵӂҽӮʩɐԄӸˑҽҤӫӮԓʩɐҹԅҽқӮʩɐҟӯӫԊӼ ˍҕӴӚԑʩɐӥҒҕҩˑɐũˍˑԑʩɐʵʳҹӮʩ اﻟﻔﺎﺿﻞ/ ﻓﻴﺼﻞ اﻟﺮواﺣﻲ املﺤرتم،،، ﺗﺤﻴﺔ ﻃﻴﺒﺔ وﺑﻌﺪ،،، ﻧﻮد إﻋﻼﻣﻜﻢ ﺑﺄن اﻟﻘﺴـﻢ ﺳـﻴﻌﻘﺪ اﺟﺘ¯ﻋًﺎ ﻳﻮم اﻻﺛﻨ\u000e املﻘﺒﻞ يف ¿ﺎم اﻟﺴـﺎﻋﺔ ٩:٠٠ ﺻﺒﺎﺣًـﺎ؛ ملﻨﺎﻗﺸـﺔ أدوار وﻣﺴـﺆوﻟﻴﺎت اﻷﻋﻀﺎء.","embedding":[0.03661,0.03661,0,0.07321,0.07321,0.07321,0,0.07321,0.03661,0.03661,0.10982,0,0,0.10982,0,0.03661,0.1388,0.03661,0,0.03661,0.03661,0,0.03661,0.13519,0.14642,0.06198,0.12396,0,0.03661,0,0.14642,0.03661,0,0.10982,0.03661,0.03661,0.09859,0,0.07321,0.03661,0.07321,0.07321,0.03661,0,0,0.07321,0,0.03661,0.03661,0.03661,0.09859,0.07321,0.03661,0.07321,0.07321,0.03661,0,0.07321,0.07321,0.11343,0.20534,0.03661,0.03661,0,0.03661,0,0.07682,0,0,0,0,0.14444,0,0.03661,0,0.03661,0,0,0.03661,0.03661,0.07321,0.03661,0.13519,0,0,0.03661,0.03661,0,0.07682,0,0.03661,0,0.06198,0.03661,0,0.07682,0.07321,0,0.03661,0.03661,0.03661,0.10982,0.03661,0.03661,0.16057,0.09552,0.06198,0,0.09859,0.03661,0.09859,0.07321,0.0