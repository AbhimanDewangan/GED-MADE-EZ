.03297,0.06919,0.08879,0.06594,0.03297,0.14186,0,0.07868,0.03297,0,0.03297,0.05582,0,0.03297,0,0.08879,0.09891,0,0,0,0.03297,0.03297,0,0,0.19604,0.03297,0,0.12176,0.06919,0.03297,0,0.06594,0.07868,0,0.03297,0,0.16747,0,0.06594,0,0.10889,0.09891,0.06594,0,0.06594,0,0.08879,0,0.06594,0,0.12176,0.03297,0,0.20369,0,0.08879,0.06919,0,0,0.03297,0,0,0.03297,0,0.03297,0.119,0.06594,0,0.03297,0.12176,0.05582,0.03297,0.03297,0,0.12438,0.03297,0.03297,0.03297,0,0.03297,0.03297,0.03297,0.03297,0.09891,0.03297,0,0,0,0,0.03297,0,0.03297,0,0,0,0.06594,0.06594,0.09891,0.06594,0.03297,0,0,0.08879,0.03297,0.15935,0.06594,0.03297,0.09891,0.03297,0.03297,0.03297,0.08879,0,0,0,0.13513,0,0]},{"id":"moe-shared::moe-997a541e8ad3fa44::11","bookId":"moe-997a541e8ad3fa44","title":"دليل معلم العلوم والبيئة الصف الحادي عشر الفصل الأول","subjectId":"general","pageStart":22,"pageEnd":24,"chunkIndex":11,"text":"فالتقويم من أجل التعلم يجعل التعلم أكثر وضوحًا، بما يساعد الطلبة على فهم طبيعة المادة التي يتعلمونها، بشكل أكثر دقة، وفهم أنفسهم كمتعلمين. كما تصبح جودة التفاعالت والتغذية الراجعة بين الطلبة والمعلمين بالغة األهميّة لدعم عمليّة التعلم. التقويم من أجل التعلم أين هو المتعلِّم اآلن كيفية الوصول إلى الهدف إلى أين يتجه دليل المعلّم العلوم البيئية - الصف الحادي عشر - الفصل الدراسي األول: xxii يمكن استخدام التقويم من أجل التعلم لمساعدة الطلبة على التركيز على جوانب محددة في تعلمهم، وتحمل المزيد من المسؤوليّة عن كيفيّة متابعة التعلم. إذ يكوّن التقويم من أجل التعلم ارتباطًا قيمًا بين التقويم وأنشطة التعلم، حيث سيكون لتوضيح األهداف تأثير مباشر على كيفيّة تصميم استراتيجيات التعليم والتعلم. ويمكن أن تدعم تقنيات التقويم من أجل التعلم الطلبة ليصبحوا أكثر ثقة بما يتعلمونه، وللتفكير في الطريقة التي يتعلمون بها. ومن المرجح أن يجربوا نهجًا جديدًا، ويكونوا أكثر اندماجًا بما يطلب إليهم تعلمه. ما صعوبات استخدام التقويم من أجل التعلم؟ ال يعني استخدام التقويم من أجل التعلم الحاجة إلى اختبار الطلبة بشكل متكرر. سيكون من السهل فقط زيادة مقدار التقويم الختامي، واستخدام هذا التقويم كطريقة منظمة للمساعدة في تحديد ما يجب القيام به في عمليّة التعليم. يمكن الحكم على مقدار ما تحقق من تعلم بوسائل أخرى غير االختبار، بما في ذلك -وقبل كل شيء- التواصل مع الطلبة بطرائق متنوّعة، ومعرفتهم بشكل أفضل كأفراد. xxiii استخدام األسئلة لتحسين التعلُّم استخدام األسئلة لتحسين التعلم ال يتطوّر التفكير إال من خالل األسئلة ال اإلجابات. ويحقق الطلبة تعلمًا أفضل عندما تتوافر لهم الفرص الكافية للتعامل مع األسئلة وإجابتها. يمكن استخدام األسئلة بفاعليّة في غرفة الصف لما يأتي: مراجعة التعلم. \u001a حفز تفكير الطلبة. \u001a حفز اهتمام الطلبة ودافعيتهم للمشاركة بنشاط في الدرس. \u001a تنمية مهارات التفكير الناقد. \u001a حفز الطلبة على طرح األسئلة. \u001a تتوافر عدة طرائق يمكن من خاللها تحقيق ذلك. ومن المحتمل أنك -اعتمادًا على محتوى الدرس وأهدافه- ستستخدم ثالثة أنواع من األسئلة مع األمثلة كاآلتي: مساعدة يجب أن تعد ّ األسئلة مسبقًا لضمان مناسبتها لجميع الطلبة. أسئلة المناقشة وهي أسئلة سابرة تسهّل المناقشة وتؤمّن فهمًا أفضل لتفكير الطلبة (وفي بعض المواقف قدرتهم على التخيل). لماذا تعتقد ذلك؟ مثال: يمكن تطبيقه على مستوى مجموعات ثنائية، أو مجموعات صغيرة، أو على مستوى الصف ككل. ال تتطلب أسئلة نشاط: المناقشة «إجابة صحيحة»، إذ تكمن أهميتها في مساعدة الطلبة على التفكير، والمشاركة والمناقشة. أسئلة تشخيصية تؤمّن هذه األسئلة نظرة سريعة عن مدى تعلم الطلبة لما درّسته إيّاهم. قد تحدّد اإلجابات أجزاء من المحتوى تتطلب إعادة التدريس لتوضيح المفاهيم الخاطئة أو ملء الثغرات. ويمكنها تحديد ثغرات معيّنة في فهم الطلبة من دون التأثير على سير الحصة. صح أم خطأ. مثال: قد يكون في بداية الدرس (باستخدام ألواح الكتابة الصغيرة أو أوراق المالحظات الالصقة)، أو كجزء من اختبار نشاط: قصير، أو أي شكل آخر للتقويم. يجب أن يكون لجميع أسئلة التشخيص هدف محدّد. يجب استخدام المعلومات المجمّعة للمساعدة في توجيه التدريس.","embedding":[0,0.12883,0.03221,0.03221,0.06759,0,0,0.03221,0.09663,0.03221,0.03221,0,0,0.03221,0.03221,0.15751,0.03221,0,0.05453,0.15116,0,0.14128,0,0.08674,0,0.13201,0.03221,0.0998,0,0.03221,0.03221,0,0.03221,0.03221,0.06442,0.13139,0.03221,0.11224,0.17396,0.05453,0.03221,0,0.05453,0.12213,0.09663,0.03221,0.06442,0.03221,0.03221,0.05453,0,0.03221,0,0,0,0.06442,0.03221,0.03221,0.09663,0.06759,0.10907,0.03221,0.06442,0.06442,0,0,0,0.12883,0.03221,0.05453,0.03221,0.03221,0.06442,0,0.08674,0,0.06442,0.06442,0.09663,0.03221,0.10907,0.07686,0.06442,0,0,0,0.03221,0,0.03221,0.03221,0,0.03221,0,0.03221,0.06442,0.03221,0,0.05453,0.14128,0.03221,0.03221,0,0,0.06759,0,0,0.05453,0.06442,0.06442,0.09663,0.03221,0.03221,0,0,0.03221,0.03221,0,0,0.06442,0.03221,0.06442,0.03221,0.12709,0,0.03221,0.03221,0.03221,0.03221,0.03221,0.05453,0.06442,0.03221,0.05453,0.12883,0,0,0.06442,0,0.03221,0.11625,0.03221,0.03221,0,0.06759,0,0,0.03221,0,0.06442,0,0.03221,0.03221,0.06442,0.06442,0.03221,0,0,0.03221,0.12883,0,0.03221,0,0.13201,0.06442,0,0.03221,0.10907,0,0,0.09663,0.03221,0,0.03221,0.03221,0.18654,0,0.08674,0,0.12151,0,0.12709,0,0.06442,0.03221,0.06442,0.06442,0,0.03221,0.03221,0,0.11895,0.16422,0.06442,0.09663,0.05453,0.03221,0.06442,0,0,0,0,0,0.13201,0.13519,0.03221,0.03221,0,0.06442,0,0.03221,0.03221,0,0.11482,0,0,0.08674,0.06442,0.03221,0.03221,0,0.03221,0.03221,0.06442,0,0,0.03221,0,0.06442,0.03221,0,0,0,0.203,0.05453,0.03221,0.1996,0.06442,0,0,0,0.03221,0,0.14165,0.05453,0.06442,0.06442,0.05453,0.03221,0.0998,0.03221,0,0,0.03221,0.14128,0.03221,0.03221]},{"id":"moe-shared::moe-997a541e8ad3fa44::12","bookId":"moe-997a541e8ad3fa44","title":"دليل معلم العلوم والبيئة الصف الحادي عشر الفصل الأول","subjectId":"general","pageStart":24,"pageEnd":26,"chunkIndex":12,"text":"ويمكنها تحديد ثغرات معيّنة في فهم الطلبة من دون التأثير على سير الحصة. صح أم خطأ. مثال: قد يكون في بداية الدرس (باستخدام ألواح الكتابة الصغيرة أو أوراق المالحظات الالصقة)، أو كجزء من اختبار نشاط: قصير، أو أي شكل آخر للتقويم. يجب أن يكون لجميع أسئلة التشخيص هدف محدّد. يجب استخدام المعلومات المجمّعة للمساعدة في توجيه التدريس. وفي الصفحة التالية اقتراحات حول كيفيّة استخدام نتائج التشخيص في التغذية الراجعة. دليل المعلّم العلوم البيئية - الصف الحادي عشر - الفصل الدراسي األول: xxiv األسئلة المفصليّة «المفصل» هو النقطة التي تنتقل عندها من فكرة أو نشاط أو نقطة مفتاحيّة إلى أخرى. واألسئلة المفصليّة نوع معيّن من األسئلة التشخيصيّة التي قد تكون مفيدة بعد التعلم، للمساعدة في اتخاذ قرار لالستمرار في التدريس أو التلخيص أو إعادة التدريس. عادة ما يكون فهم المحتوى قبل نقطة المفصل شرطًا أساسيًا للجزء التالي من التعلم. وهذا أمر مهم، ألن االنتقال هنا أمر خطر ٌ إذا لم تكن المفاهيم المفتاحيّة مكتسبة تمامًا. بالمقابل، إذا أخطأت وأعدت التدريس بدون جدوى، فستكون المشاركة معدومة. ماذا تعلمنا اليوم؟ وما أهميته؟ مثال: قائمة باألفكار (محدّدة الوقت)، في إطار عمل فردي أو ضمن ثنائيات، ويمكن كتابتها على ورق الصق أو تشاركها نشاط: شفويًا. لكي تكون األسئلة المفصليّة مفيدة، يجب أن تكون قادرًا على استنباط المعلومات من الطلبة بشكل فوري، وأن تكون قادرًا على فهمها، والتصرّف بناء عليها بسرعة. ويفترض أحد المقترحات أنه يجب على الطلبة اإلجابة في غضون دقيقة واحدة، ثانية. تهدف األسئلة المفصليّة للحصول على إجابة ١٥ وأن يكون المعلم قادرًا على عرض اإلجابات وتفسيرها في غضون على شكل جملة قصيرة وليس مقالة. يفترض استخدام مجموعة متنوّعة من األسئلة في ضوء الممارسات المهنيّة، وبما يتناسب مع الصف والموضوع ومستوى الطلبة. استخدام التغذية الراجعة لتحسين التدريس والتعلم تعمل األسئلة على تطوير فهم الطلبة لموضوع معيّن وتساعد في استكشاف أهدافه، كما تساعدهم في تحديد المجاالت التي ال يكونون واثقين من فهمها، بما يمثل جزءًا مهمًا في عمليّة التعلم. فالتغذية الراجعة تدعم الطلبة في تجاوز حالة عدم الثقة، وتعزز من كفاءتهم. ألنه بمجرد أن يتضح لهم ما عليهم عمله لتجاوز حدود تعلمهم الحاليّة، فإنهم سيكونون قادرين على تحقيق تقدم أكبر. يجب أن تكون التغذية الراجعة: شفوية أو كتابية. \u001a مناسبة للطلبة. \u001a تتضمن معلومات توجه الطالب إلى المصدر الذي يفيده (على سبيل المثال، صفحات في كتاب الطالب). \u001a التغذية الراجعة فعالة لتحسين التدريس والتعلم حيث يجب تأمين بيئة تحفز الطلبة على التفكير في خبرات تعلمهم وتحديد مسيرتهم التعلمية. وقد تأخذ هذه الخطوات شكل أسئلة إضافيّة عن الموضوع الذي يرغب الطلبة في البحث عن إجابات لها، أو تكون مرتبطة بمعرفتهم من كتاب الطالب (لمزيد من المعلومات حول التفكير ما وراء المعرفة، ارجع إلى النصوص ذات الصلة في هذه المقدمة). xxv التقييم الذاتي/ تقييم األقران ً من االعتماد دائمًا على تقييم المعلم. ويمكن ال يمكن للطلبة تقييم مدى تقدمهم أو تقدم زمالئهم في المجموعة، بثقة، بد للطلبة الذين تتاح لهم إمكانيّة اإلطالع على عملهم، وعلى سلم العالمات الذي يعكس أهدافًا ومعايير واضحة، تقييم مدى جودة عملهم.","embedding":[0.11328,0.11328,0.03067,0,0.06437,0.03067,0,0.06437,0.06134,0,0.09202,0.03067,0,0.06134,0,0.1163,0,0.03067,0.05193,0.09202,0.06134,0.06134,0.03067,0.0826,0,0.11328,0.06134,0.06437,0,0.03067,0.03067,0.03067,0,0,0.03067,0.09202,0,0.11162,0.21714,0.05193,0.09202,0.06134,0,0.03067,0.06134,0.03067,0.06134,0.03067,0.09202,0.0826,0.03067,0.03067,0.03067,0,0.03067,0.06134,0.03067,0.06134,0.06134,0.06134,0.13454,0,0.03067,0,0,0,0.06134,0.12269,0,0.12571,0,0.0826,0.03067,0,0.09202,0.0826,0,0.06134,0.0826,0.05193,0.13454,0.13756,0.03067,0.03067,0,0.03067,0,0,0,0,0,0,0.03067,0,0,0.03067,0,0.03067,0.13454,0.03067,0.03067,0.03067,0.03067,0.03067,0.03067,0.03067,0.06437,0,0.09202,0.03067,0.03067,0.06134,0.06437,0,0.11328,0,0.05193,0.11328,0.06134,0.13454,0.03067,0.03067,0.03067,0.03067,0.0826,0,0,0.06134,0.03067,0.06134,0.03067,0,0,0.13454,0.03067,0,0.03067,0,0,0.06134,0.14138,0,0,0.05193,0.03067,0.0826,0.03067,0,0.12269,0.03067,0,0.11328,0.03067,0.12269,0.03067,0.03067,0,0,0.03067,0,0.03067,0.03067,0.09202,0.06134,0.03067,0.09202,0.11328,0,0.03067,0.03067,0.06134,0.03067,0.09504,0,0.13756,0.06134,0.03067,0.06134,0.13756,0,0.07319,0,0.06134,0,0.12571,0.03067,0.03067,0.03067,0,0,0.06134,0.16823,0.06134,0,0.03067,0.06134,0.03067,0,0.06134,0,0,0.03067,0,0,0.03067,0.03067,0.1163,0,0.08563,0.07319,0.09202,0,0.06437,0,0,0.08563,0.13454,0.06134,0,0,0.05193,0.03067,0.06134,0,0,0.03067,0.03067,0.12571,0.03067,0,0,0.06134,0.16521,0.03067,0.06437,0.03067,0.09202,0.03067,0,0,0,0,0.18233,0.03067,0.03067,0.09202,0.14395,0.06134,0.05193,0.0826,0,0,0,0.09202,0,0]},{"id":"moe-shared::moe-997a541e8ad3fa44::13","bookId":"moe-997a541e8ad3fa44","title":"دليل معلم العلوم والبيئة الصف الحادي عشر الفصل الأول","subjectId":"general","pageStart":25,"pageEnd":27,"chunkIndex":13,"text":"وقد تأخذ هذه الخطوات شكل أسئلة إضافيّة عن الموضوع الذي يرغب الطلبة في البحث عن إجابات لها، أو تكون مرتبطة بمعرفتهم من كتاب الطالب (لمزيد من المعلومات حول التفكير ما وراء المعرفة، ارجع إلى النصوص ذات الصلة في هذه المقدمة). xxv التقييم الذاتي/ تقييم األقران ً من االعتماد دائمًا على تقييم المعلم. ويمكن ال يمكن للطلبة تقييم مدى تقدمهم أو تقدم زمالئهم في المجموعة، بثقة، بد للطلبة الذين تتاح لهم إمكانيّة اإلطالع على عملهم، وعلى سلم العالمات الذي يعكس أهدافًا ومعايير واضحة، تقييم مدى جودة عملهم. سيساعدهم ذلك في المشاركة في عمليّة تعلمهم ويحسّن استقالليتهم ودافعيتهم. مراجع إضافيّة Gaunt, A. and Stott, A. (2019) Transform teaching and learning through talk: the oracy imperative, Rowman and Littlefield Education, Lanham, MD. Gershon, M. (2013) How to use questioning in the classroom: the complete guide, Amazon Media. Paul, R.W. and Elder, L. (2000), Critical thinking: basic theory and instructional structures handbook, Foundation for Critical Thinking, Tomales, CA. Wiliam, D. (2011), Embedded Formative Assessment, Solution Tree Press, Bloomington, IN . استخدام األسئلة لتحسين التعلّم دليل المعلّم العلوم البيئية - الصف الحادي عشر - الفصل الدراسي األول: xxvi التفكير ما وراء المعرفة (توسيع التفكير) ما هو توسيع التفكير ؟ يصف مصطلح التفكير ما وراء المعرفة العمليات التي يقوم بها الطلبة بالتخطيط والتتبع والتقييم وتغيير سلوكيات التعلم. وهي تجعل تفكير الطلبة في تعلمهم أكثر وضوحًا، كما تجعلهم متأكدين من قدرتهم على تحقيق هدف التعلم الذي حدّدوه ألنفسهم أو حدّده المعلم لهم. يتعرّف الطلبة في التفكير ما وراء المعرفة على الموضوعات التي يجدونها سهلة أو صعبة. ويدركون متطلبات المهمات التعلميّة المختلفة، ويكونون قادرين على تحديد النهوج المختلفة التي يمكنهم استخدامها للتعامل مع المشكالت. كما يمكنهم إجراء تعديالت على تعلمهم، وهم يتابعون تقدمهم نحو تحقيق هدف معيّن. يوضح الرسم التخطيطي التالي طريقة مفيدة للتفكير في المراحل المتضمنة في التفكير ما وراء المعرفة. التخطيط المراقبة التقييم التأمل يفكر الطلبة أثناء مرحلة التخطيط في هدف التعلم الواضح المحدّد لهم، وفي متطلبات تنفيذه. ومن المهم التوضيح للطلبة كيف تكون المهمة ناجحة قبل القيام بها. ويبني الطلبة على معارفهم السابقة، ويفكرون في االستراتيجيات التي استخدموها سابقًا، وكيف سيتعاملون مع المهمة الجديدة. يتابع الطلبة باستمرار أثناء تنفيذ خطتهم مدى تقدمهم تجاه تحقيق هدف التعلم. وفي حالة عدم نجاح االستراتيجيات المستخدمة، يمكنهم تجربة استراتيجيات أخرى. يحدّد الطلبة مدى نجاح االستراتيجية المستخدمة لتحقيق هدف التعلم بمجرد االنتهاء من المهمة. ويفكرون أثناء تقييمهم في األمور التي سارت بشكل جيد وتلك التي لم تحقق المطلوب، بما يساعدهم في العمل بشكل مختلف في المرة القادمة. قد يفكرون أيضًا في أنواع المشكالت األخرى التي يمكن حلها باستخدام االستراتيجية نفسها. التفكير جزء أساسي في عمليّة التخطيط - تتبع التقييم- وتوجد عدة طرائق لدعم تفكير الطلبة في عمليّة تعلمهم.","embedding":[0,0.05667,0.07024,0,0,0.03347,0,0.07024,0.13388,0.03347,0.03347,0.09014,0.07024,0.03347,0,0.03347,0,0.09014,0,0,0.06694,0.06694,0.12081,0.06694,0,0.10041,0.06694,0.09344,0.03347,0.08734,0.10041,0.03347,0.03347,0,0,0.03347,0.06694,0.16555,0.17396,0,0.03347,0,0,0.06694,0.03347,0,0,0.03347,0.05667,0.06694,0,0.03347,0,0.09014,0.05667,0.03347,0,0,0.06694,0.05667,0.06694,0.06694,0,0.03347,0,0,0.03347,0.03347,0,0.03347,0.06694,0,0,0.06694,0.10041,0.03347,0,0,0,0.06694,0.03347,0.03347,0.06694,0.07024,0.06694,0.06694,0.03347,0.10041,0.03347,0.03347,0.03347,0.10041,0.03347,0,0,0,0,0,0.10041,0,0,0,0.03347,0,0.03347,0.12361,0.0986,0.10041,0.13388,0.10371,0,0.06694,0.06694,0,0.03347,0,0.17066,0.05667,0.06694,0.10041,0.06694,0.03347,0.03347,0,0.03347,0,0.03347,0.10041,0,0.06694,0.06694,0,0.03347,0.13719,0.03347,0,0.05667,0.12691,0,0.11334,0.03347,0.03347,0,0.10307,0.03347,0.03347,0,0.03347,0.03347,0.03347,0.03347,0.09014,0.06694,0.03347,0.03347,0,0,0,0.05667,0,0,0.03347,0.14401,0.06694,0.03347,0,0.15428,0.03347,0,0,0.03347,0.06694,0.03347,0.03347,0.11334,0,0.06694,0.12361,0.15428,0,0.12361,0.03347,0.05667,0,0.10371,0.06694,0.03347,0,0.06694,0.09014,0.03347,0.11334,0.03347,0,0.06694,0,0,0.03347,0,0,0.03347,0.06694,0.03347,0,0.03347,0.03347,0.03347,0.03347,0.05667,0.03347,0.10041,0,0.08734,0.03347,0.10041,0,0.13654,0.10371,0.03347,0,0.18029,0,0.06694,0.03347,0.03347,0.03347,0,0.03347,0.13719,0.06694,0,0.06694,0.03347,0.03347,0.03347,0,0,0.06694,0,0.03347,0.03347,0,0.16177,0,0.12361,0,0.09014,0.06694,0.06694,0.14681,0,0,0,0.10371,0.03347,0.03347]},{"id":"moe-shared::moe-997a541e8ad3fa44::14","bookId":"moe-997a541e8ad3fa44","title":"دليل معلم العلوم والبيئة الصف الحادي عشر الفصل الأول","subjectId":"general","pageStart":27,"pageEnd":29,"chunkIndex":14,"text":"ويفكرون أثناء تقييمهم في األمور التي سارت بشكل جيد وتلك التي لم تحقق المطلوب، بما يساعدهم في العمل بشكل مختلف في المرة القادمة. قد يفكرون أيضًا في أنواع المشكالت األخرى التي يمكن حلها باستخدام االستراتيجية نفسها. التفكير جزء أساسي في عمليّة التخطيط - تتبع التقييم- وتوجد عدة طرائق لدعم تفكير الطلبة في عمليّة تعلمهم. ويحتاج الطلبة في تطبيق نهج التفكير ما وراء المعرفة إلى تعرّف مجموعة من االستراتيجيات التي يمكنهم استخدامها، وتعرّف بيئة الصف التي تحفزهم على استكشاف مهارات التفكير ما وراء المعرفة وتطويرها. xxvii التفكير ما وراء المعرفة (توسيع التفكير) لماذا نعلّم مهارات التفكير ما وراء المعرفة؟ تشير األبحاث إلى أن استخدام مهارات التفكير ما وراء المعرفة يؤدّي دورًا مهمًا في التعلم الناجح. فهذه المهارات تساعد الطلبة على تتبع تقدمهم والتحكم في تعلمهم، والذين يمارسونها يفكرون في أخطائهم، ويتعلمون منها، ويعدلون استراتيجيات تعلمهم تبعًا لذلك. كما يجد الطلبة الذين يستخدمون مهارات التفكير ما وراء المعرفة أنها تحسّن من تحصيلهم في الموضوعات المختلفة، حيث تساعدهم على نقل ما تعلموه من سياق إلى سياق آخر، أو من مهمة سابقة إلى مهمة جديدة. ما الصعوبات التي تواجه تطوير مهارات التفكير ما وراء المعرفة؟ من المهم حفز الطلبة على تخصيص وقت للتفكير في مهارات التفكير ما وراء المعرفة والتعلم من أخطائهم، لتكون هذه ً للتعرّض للمخاطر ال المهارات شائعة في غرفة الصف. يخشى العديد من الطلبة ارتكاب األخطاء، بما يعني أنهم أقل احتما واستكشاف طرائق جديدة في التفكير أو معالجة مشكالت غير مألوفة. وحيث إن المعلم يسهم في تشكيل ثقافة التعلم في غرفة الصف، ولكي تنشط ممارسات التفكير ما وراء المعرفة، يحتاج الطلبة إلى الشعور بالثقة الكافية أثناء ارتكاب األخطاء، ومناقشتها، وعرضها في النهاية كونها فرصًا تعلميّة قيّمة، وفي كثير من األحيان ضروريّة. دليل المعلّم العلوم البيئية - الصف الحادي عشر - الفصل الدراسي األول: xxviii التعليم المتمايز (تفريد التعليم) ما هو التعليم المتمايز؟ يقدم التعليم المتمايز عادة كممارسة تعليميّة ينظر فيها المعلم إلى الطلبة كأفراد، وإلى التعلم كعمليّة شخصيّة. وعلى الرغم ّ أنه ينظر عادة إلى الهدف الرئيسي للتعليم المتمايز باعتباره ضمان إحراز جميع ال من أن التعريفات الدقيقة قد تختلف، إ الطلبة -بغض النظر عن قدراتهم واهتماماتهم- تقدمًا نحو تحقيق نتاجات التعلم. يتعلق األمر باتّباع نهج مختلف وإدراك االختالفات بين الطلبة لمساعدتهم على تحقيق التقدم. لذا يحتاج المعلم إلى أن يكون مستجيبًا وراغبًا وقادرًا على تكييف تدريسه بما يلبي متطلبات الطلبة. ال يوجد نهج واحد على المعلم اتّباعه، وال يفترض للمعلم مراعاة ما يميّز كل طالب كل يوم. لكن عليه تحديد اللحظات المناسبة أثناء الدرس لتعرّف ما يميّز الطالب. بكلمات أخرى، تمثل مراعاة التعليم المتمايز الفاعل جزءًا من خطة الدرس اليوميّة للمعلم الخبير. من المهم أن يكون المعلم قادرًا على االستجابة لمتطلبات الطلبة، واستخدام التقنيات التي يراها أكثر مالءمة. قد يصعب تنفيذ جميع محتوى المنهاج ودعم جميع الطلبة وضمان مشاركتهم المستمرة في عمليّة التعلم، وهو ما يمثل تحديًا يواجهه جميع المعلمين في العالم.","embedding":[0.0655,0.09825,0.0882,0.03275,0.03275,0,0,0,0,0,0,0.09825,0.0655,0.09825,0.03275,0,0,0.0655,0.03275,0,0.0655,0.0655,0.13746,0.03275,0.03275,0.09825,0.0655,0.15419,0.03275,0.10471,0.03275,0.08546,0,0,0,0.13423,0.0655,0.13361,0.18226,0.09825,0.03275,0,0.03275,0,0.12418,0.0655,0.03275,0,0,0,0,0.0882,0,0.03275,0.0655,0.03275,0,0.0655,0.0655,0.03275,0.23186,0.05545,0.13423,0,0,0,0,0.03275,0,0,0.1109,0.03275,0,0.0655,0,0.03275,0.0655,0,0.0655,0.03275,0.05545,0,0.17641,0.03275,0.0655,0.03275,0,0.0655,0.0655,0.03275,0.03275,0,0.03275,0,0.03275,0.0655,0,0,0.13423,0.03275,0.03275,0,0.0882,0.05545,0,0.03275,0.09648,0,0.03275,0.06873,0.03275,0.03275,0.03275,0.03275,0,0,0.0655,0.15096,0.131,0.05545,0.0655,0.09825,0,0.14366,0.09825,0.03275,0.0882,0.03275