ـــﺘُﻌﺪ ﺍملﻘـــﺮﺭ ﻫـــﺬﺍ ﺩﺭﺍﺳـــﺔ ﺧـــﻼﻝ ﻣـــﻦ ﺗﻨﻤﻴﺘـــﻬﺎ ﺗـــﺘﻢ ﺍﻟـــيت ﺍملﻬـــﺎﺭﺍﺕ ﺍﻻﺟﺘﻤﺎﻋﻴـــــــــــﺔ ﺍﻟﺪﺭﺍﺳـــــــــــﺎﺕ جمـــــــــــﺎﻝ يف ﺍﻟﻌـــــــــــﺎيل ﺍﻟﺘﻌﻠـــــــــــﻴﻢ ﻣﺆﺳـــــــــــﺴﺎﺕ ) ﺍﻟﺘـــــــــــﺎﺭﻳﺦ ﻭﺍﻟﺴﻴﺎﺣﺔ ﺍﻻﺟﺘﻤﺎﻉ،ﻭﺍﻻﻗﺘﺼﺎﺩ،ﻭﺍﻟﺰﺭﺍﻋﺔ ،ﻭﺍجلﻐﺮﺍﻓﻴﺎ،ﻭﻋﻠﻢ ( ﺍملﻘﺮﺭ ﻫﺬﺍ ﺗﺪﺭﻳﺲ ﻋﻠﻰ ﺍﻟﻘﺎﺩﺭﻭﻥ ﺍملﻌﻠﻤﻮﻥ : - ﻣﻌﻠﻤﻮ ﺍﻻﺟﺘﻤﺎﻋﻴﺔ ﺍﻟﺪﺭﺍﺳﺎﺕ . - ﺍﻟﺘﺎﺭﻳﺦ ﻣﻌﻠﻤﻮ . - ﺍجلﻐﺮﺍﻓﻴﺎ ﻣﻌﻠﻤﻮ . ﺭﻗﻢ ﺍﻟﻮﺯﺍﺭﻱ ﺍﻟﻘﺮﺍﺭ ﻭﻓﻖ ﺍملﻌﺘﻤﺪ ﺍﻟرب￿ﺎﻣﺞ ) ١٦٠ / ٢٠٠٧ ﻡ ( - ٨٧ - ﺍﻟﺪﺭﺍﺳﻲ ﺍملﻘﺮﺭ ﺍﺳﻢ : ﺍﻻﺟﺘﻤﺎﻋﻴﺔ ﺍﻟﺪﺭﺍﺳﺎﺕ ) ﻭﺍﺪ ﺍﻟﻌﺮﺍﻗﺔ يف ﻭﻃين ﻫﺬﺍ ( ﺍﻟﺪﺭﺍﺳﻴﺔ ﺍملﺎﺩﺓ : ﺍﻻﺟﺘﻤﺎﻋﻴﺔ ﺍﻟﺪﺭﺍﺳﺎﺕ . ﺍﻟﺼﻒ : ﻋﺸﺮ ﺍﻟﺜﺎ￿ﻲ . ﺍﻷﺳﺒﻮﻉ يف ﺍحلﺼﺺ ﻋﺪﺩ : ﺣﺼﺘﺎﻥ ﺍملﻘﺮﺭ ﻓﻴﻪ ﺳﻴﻄﺮﺡ ﺍﻟﺬﻱ ﺍﻟﻌﺎﻡ : ٢٠٠٨ / ٢٠٠٩ ﻟﻠﻤﻘﺮﺭ خمﺘﺼﺮ ﻭﺻﻒ : ﻟـــﺴﻠﻄﻨﺔ ﺍحلـــﻀﺎﺭﻱ ﺍﻟﺘﻄـــﻮﺭ ﺣـــﻮﻝ ﺑﺎملﻌﺮﻓـــﺔ ﺍﻟﻄـــﻼﺏ ﻟﺘﺰﻭﻳـــﺪ ﻣـــﺼﻤﻢ ﺍﻟﺪﺭﺍﺳـــﻲ ﺍملﻘـــﺮﺭ ﻫـــﺬﺍ ﻭﻋﻠــــﻢ ﻭﺍﻹ￿ﺘــــﺎﺝ ﻭﺍﻟﻌﻤــــﻞ ﺍﻟﺒﻴﺌــــﺔ ﻭ ﺍﻟﺘــــﺎﺭﻳﺦ جمــــﺎﻝ يف ﻣﻮﺿــــﻮﻋﺎﺕ ﺩﺭﺍﺳــــﺔ ﺧــــﻼﻝ ﻣــــﻦ ﻋﻤــــﺎﻥ ﻭﺍملﻮﺍﻃﻦ ﺍﻟﻮﻃﻦ هتﻢ ﻣﻮﺍﺿﻴﻊ جمﻤﻮﻋﺔ ﺇىل ﺇﺿﺎﻓﺔ ﻭﺍﻟﺴﻴﺎﺣﺔ ﺍﻻﺟﺘﻤﺎﻉ ﺍمل حملﺘﻮﻯ ﺍﻟﻌﺎﻡ ﺍملﺨﻄﻂ ﺍﻟﺪﺭﺍﺳﻲ ﻘﺮﺭ : ﺗﻜـــﻮﻳﻦ ﻭ ، ﺑـــﺒﻼﺩﻫﻢ ﻭﻣﻌﺮﻓﺘـــﻬﻢ ﺍﻟﻄـــﻼﺏ ﺇﺩﺭﺍﻙ ﻣـــﺴﺘﻮﻯ ﺭﻓـــﻊ ﻫـــﻮ ﺍملﻘـــﺮﺭ هلـــﺬﺍ ﺍﻟﻌـــﺎﻡ ﺍهلـــﺪﻑ ﺇىل ﺍﻟﻮﻃين،ﺇﺿــــﺎﻓﺔ ﺍملــــﺴﺘﻮﻯ ﻋﻠــــﻰ ﺍﻟﺘﻨﻤﻴــــﺔ ﻟﺘﺤﻘﻴــــﻖ ﻭﺍﻹ￿ﺘــــﺎﺝ ﺍﻟﻌﻤــــﻞ حنــــﻮ ﺍجيﺎﺑﻴــــﺔ ﺍجتﺎﻫــــﺎﺕ ﺍﻟﻄﻠﺒﺔ ﻟﺪﻯ ﺍملﻮﺍﻃﻨﺔ ﺟﺎ￿ﺐ ﺗﻌﺰﻳﺰ . ١ . ﺍﻟﺘـــﺎﺭخيﻲ ﺍجلﺎ￿ـــﺐ : ﻟﻌﻤـــﺎﻥ ﺍﻹﺳـــﻼﻣﻲ ﺍﻟﺘـــﺎﺭﻳﺦ ﻋﻤـــﺎﻥ ﻭﺧـــربﺍﺕ ﺍﻟﻨﻬـــﻀﺔ ﻋـــﺼﺮ ﺣﺘـــﻰ ﺍحلﻀﺎﺭﻳﺔ . ٢ . ﺍجلﻐـــﺮﺍيف ﺍجلﺎ￿ـــﺐ : ﺍﻟﺒﻴﺌـــﻲ : ، ﺍﺳـــﺘﺪﺍﻣﺘﻬﺎ يف ﺍﻟـــﺴﻠﻄﻨﺔ ﻭﺩﻭﺭ ﺍﻟﻌﻤﺎ￿ﻴـــﺔ ﺍﻟﺒﻴﺌـــﺔ ﻣﻜﻮ￿ـــﺎﺕ ﺍﻟﺴﻠﻄﻨﺔ يف ﻭﺍﻟﺘﺤﻀﺮ ﻭﺍﻟﺴﻜﺎﻥ ﺍملﻴﺎﻩ ﺇىل ﺍجلﺎ￿ﺐ ﻫﺬﺍ ﺗﻄﺮﻕ ﻛﻤﺎ . ٣ . ﺍﻻﺟﺘﻤـــﺎﻋﻲ ﺍجلﺎ￿ـــﺐ : ، ﺗﻮﺍﺟﻬـــﻪ ﺍﻟـــيت ﻭﺍملـــﺘﻐريﺍﺕ ﻭﺗﻨـــﺸﺌﺘﻪ ، ﺍﻟﻌﻤـــﺎ￿ﻲ ﺍﻟـــﺸﺒﺎﺏ ﺗﻨـــﺎﻭﻝ ﻭﺃ￿ﺸﻄ ﺍملﺪ￿ﻲ ﺍﺘﻤﻊ ﺃمهﻴﺔ ﺇىل ﺇﺿﺎﻓﺔ ، ﻟﻠﺸﺒﺎﺏ ﺍملﺨﺼﺼﺔ ﻭﺑﺮﺍجمﻬﺎ ﺍﻟﺪﻭﻟﺔ ﺔ . ﺭﻗﻢ ﺍﻟﻮﺯﺍﺭﻱ ﺍﻟﻘﺮﺍﺭ ﻭﻓﻖ ﺍملﻌﺘﻤﺪ ﺍﻟرب￿ﺎﻣﺞ ) ١٦٠ / ٢٠٠٧ ﻡ ( - ٨٨ - ٤ . ﺍﻻﻗﺘـــﺼﺎﺩﻱ ﺍجلﺎ￿ـــﺐ : يف ﻭﻣـــﺴﺘﻘﺒﻠﻬﺎ ﻭﺍﺳـــﺘﺪﺍﻣﺘﻬﺎ ﺗﻄﻮﻳﺮﻫـــﺎ ﻭﺳـــﺒﻞ ، ﺍﻟـــﺴﻴﺎﺣﺔ ﺗﻨـــﺎﻭﻝ ﺍﻹﻋــــﺪﺍﺩ ﻭﺃمهﻴــــﺔ ﻭﺍﻹ￿ﺘــــﺎﺝ ﺍﻟﻌﻤــــﻞ ﻣﻮﺿــــﻮﻉ ﺇىل ﺍجلﺎ￿ــــﺐ ﻫــــﺬﺍ ﺗﻄــــﺮﻕ ﻛﻤــــﺎ ، ﺍﻟــــﺴﻠﻄﻨﺔ ﺍﻻﻫﺘ ﻭﻛﻴﻔﻴـــﺔ ﺍﻻﺟﺘﻤـــﺎﻋﻲ ﺍحلـــ