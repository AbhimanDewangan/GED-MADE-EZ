د ِ قناعًا ونظارات إذا لزم األمر، لحماية الرئتَين من دخول السماد إليهما. ارتد ِ قفازات عند التعامل مع السماد أو \u001a تجنّب مالمسة األسمدة مباشرة. اغسل يديك بعد االستخدام. تأكد من أن الطلبة لديهم مساحة مناسبة لتعريض جميع النباتات إلى كمية متساوية من الضوء في منطقة يسهل \u001a الوصول إليها يوميًا. لن يتمكن الطلبة من تسجيل القياسات في إجازة نهاية األسبوع؛ يمكن اعتبارها بيانات مفقودة أو يمكن لفنّي المختبر \u001a مراقبة النمو في هذا الوقت. إذا لزم األمر، يمكن إكمال هذا النشاط كعرض توضيحي للصف. \u001a 148 العلوم البيئية - الصف الحادي عشر - الفصل الدراسي الثاني: دليل المعلّم ـ إجابات دعم الطلبة إذا لزم األمر، حضِّر النباتات، والتربة، واألصص مسبقًا واطلب إلى \u001a الطلبة قياس النمو فقط. يمكن العثور على عدة أدلة لتجارب مشابهة على هذَين الرابطَين: \u001a https://youtu.be/FhK1ygoXlIk?si=VHTedDYuCpa1AFpm https://www.youtube.com/watch?v=iJrynbeBZMo صمّم جداول النتائج ليكملها الطلبة. \u001a بيانات نموذجية بيانات نموذجية لنمو النبات.","embedding":[0,0.17597,0,0.03451,0.06903,0,0.06903,0,0.05844,0.03451,0.05844,0.09295,0.05844,0.03451,0.03451,0.10354,0,0,0.03451,0.03451,0,0.03451,0.08236,0,0,0.03451,0.06903,0.03451,0.03451,0.03451,0.12746,0.03451,0.03451,0.12746,0.06903,0.03451,0,0.15908,0.09635,0.06903,0.10354,0.03451,0,0.12746,0,0,0.03451,0.03451,0.03451,0,0.03451,0.06903,0.13086,0,0.05844,0.06903,0,0.09295,0.10354,0.03451,0.1859,0.03451,0,0,0.03451,0.11687,0.06903,0.03451,0.06903,0,0,0,0.05844,0,0.07243,0.07243,0,0.03451,0,0,0.03451,0.03451,0,0,0.03451,0.03451,0.03451,0.03451,0.03451,0.07243,0,0,0.05844,0,0,0.03451,0.05844,0.03451,0.06903,0.05844,0.09295,0.06903,0,0.06903,0.05844,0.03451,0.10354,0.06903,0.03451,0.03451,0.11687,0,0.03451,0.03451,0.05844,0,0.06903,0.06903,0.03451,0.03451,0,0.10354,0.03451,0.06903,0.03451,0.06903,0.07243,0.03451,0.06903,0.03451,0.03451,0.03451,0,0,0,0.12746,0,0.06903,0,0.11687,0,0,0,0.03451,0.06903,0,0,0.03451,0.12746,0.05844,0.03451,0.03451,0.03451,0,0,0.03451,0.03451,0.03451,0,0.03451,0.03451,0,0.06903,0.03451,0,0.03451,0,0,0.03451,0,0.03451,0