# Same Google OAuth client + JWT secret as CV Ingestion System
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRE_HOURS=168
FRONTEND_URL=http://localhost:3000
# CV backend that owns the registered Google redirect URI
NEXT_PUBLIC_CV_AUTH_URL=http://127.0.0.1:8000
SUPER_ADMIN_EMAIL=abhimandewangan29@gmail.com

# Teacher role (separate from super-admin) — any one path is enough:
# TEACHER_EMAIL_DOMAINS=moe.gov.om,school.edu.om
# TEACHER_EMAILS=teacher1@example.com,teacher2@example.com
# TEACHER_INVITE_CODE=oman-teachers-2026
# Or grant from /admin → “Grant teacher role” (writes data/classrooms.json)
# Then open /teacher to create classes and share join codes.

# Optional — grounded tutor LLM + embeddings (client falls back to local hash embeddings + extractive answers)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
